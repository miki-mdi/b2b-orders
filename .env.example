# Copy this file to .env.local (preferred) or .env and fill in real values.
# .env.local and .env are both gitignored - never commit real credentials.

# Runtime connection used by the application (src/lib/db/prisma.ts), as the
# dedicated low-privilege `b2b_orders_app` role - NOT a superuser, NOT the
# database/schema owner, no DDL rights. See prisma/rls/README.md for why
# that separation is what makes Row-Level Security actually take effect.
DATABASE_URL="postgresql://b2b_orders_app:REPLACE_WITH_APP_PASSWORD@localhost:5432/b2b_orders_dev?schema=public"

# Migration connection used only by the Prisma CLI (prisma.config.ts), as
# the `b2b_orders_migrator` role, which owns the database/schema and can run
# DDL. Never used by the running application itself.
MIGRATE_DATABASE_URL="postgresql://b2b_orders_migrator:REPLACE_WITH_MIGRATOR_PASSWORD@localhost:5432/b2b_orders_dev?schema=public"

# Auth.js session/JWT signing secret. Generate one locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET"

NODE_ENV="development"

# --- Sentry error/exception reporting (optional) ---
# Error/exception capture only - no performance tracing, no Session Replay,
# no request headers/bodies/cookies/user identity/tenant identifiers are
# ever sent (see src/lib/observability/). Both vars in a pair must be set
# for that side (server or client) to initialize at all - unset/false by
# default, including under `next start`. Neither side is inferred from
# NODE_ENV.

# Server-side (Node runtime). DSN must come from a DE (Frankfurt) region
# Sentry project - host must end in .ingest.de.sentry.io, or the server SDK
# stays disabled.
SENTRY_ENABLED="false"
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""

# Client-side (shipped to the browser bundle - NEXT_PUBLIC_ vars are public;
# a DSN is a write-only ingest endpoint, not a secret, but is still gated
# the same explicit way). Independent of the server vars above - setting
# only the server pair does NOT enable client-side reporting, and vice versa.
NEXT_PUBLIC_SENTRY_ENABLED="false"
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
